# Copy to .env and edit. Everything works with the defaults (no API keys needed).

# Research Assistant language model: mock (default), anthropic, or openai
LLM_PROVIDER=mock

# Used only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Used only when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings for RAG: tfidf (default, offline) or sentence-transformers
# (requires: pip install sentence-transformers; downloads all-MiniLM-L6-v2 on first use)
EMBEDDINGS=tfidf

# SQLite database file (created automatically)
# DB_PATH=agent.db
