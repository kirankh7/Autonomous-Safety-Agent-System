# Copy to .env and edit. Everything works with the defaults (no API keys needed).

# Research Assistant language model: mock (default), anthropic, or openai
LLM_PROVIDER=mock

# Used only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional, for an API gateway instead of a direct key:
# ANTHROPIC_BASE_URL=https://your-gateway.example.com
# ANTHROPIC_API_KEY_HELPER=/path/to/command-that-prints-a-token
# ANTHROPIC_CA_BUNDLE=/path/to/corporate-ca-bundle.pem

# Used only when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Vector database for RAG: chroma (default; ChromaDB with all-MiniLM-L6-v2 embeddings,
# model downloaded once, about 80 MB) or faiss (offline fallback with TF-IDF vectors)
VECTOR_DB=chroma
# CHROMA_PATH=chroma_db

# SQLite database file (created automatically)
# DB_PATH=agent.db
